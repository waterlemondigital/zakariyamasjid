# ─────────────────────────────────────────────────────────────
# BACKEND ENVIRONMENT VARIABLES (Vercel / Production / Local)
# ─────────────────────────────────────────────────────────────

# Server Port (used locally)
PORT=5001
NODE_ENV=production

# MongoDB Connection String (from MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/zakariya_masjid
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/zakariya_masjid

# Production-Grade JWT Secret (generate a 64+ char random string)
JWT_SECRET=zakariya_masjid_trust_super_secure_jwt_secret_key_2026_quran_sunnah_welfare
JWT_EXPIRES_IN=1d

# Allowed Origins for CORS Whitelisting (comma separated)
# Include your Vercel frontend & admin domain URLs here
CORS_ORIGINS=https://zakariya-masjid.vercel.app,https://zakariya-admin.vercel.app,http://localhost:3000,http://localhost:3001

# Default Admin Credentials for First Login
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=zakariya@2026
DEFAULT_ADMIN_EMAIL=trustee@zakariyamasjid.org

# ─────────────────────────────────────────────────────────────
# EMAIL DISPATCH CONFIGURATION (Contact Form -> contact@zakariyamasjid.org)
# ─────────────────────────────────────────────────────────────
NOTIFICATION_EMAIL=contact@zakariyamasjid.org

# Standard SMTP Configuration (Gmail, Google Workspace, Zoho, Hostinger, cPanel)
# For Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS=<Google App Password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=contact@zakariyamasjid.org
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM=contact@zakariyamasjid.org

